generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                  @id @default(cuid())
  name                  String
  email                 String                  @unique
  password              String
  role                  Role                    @default(PRODUCER)
  organization          String?
  phone                 String?
  isActive              Boolean                 @default(true)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  auditLogs             AuditLog[]
  batchInspections      BatchInspection[]       @relation("BatchInspector")
  assignedDistributions DistributorAssignment[] @relation("AssignedDistributor")
  distributorProfile    DistributorProfile?
  generatedReports      LabReport[]             @relation("ReportGenerator")
  notifications         Notification[]
  producerProfile       ProducerProfile?
  assignedVerifications ProducerVerification[]  @relation("AssignedAuthority")
  qualityTests          QualityTest[]           @relation("TestConductor")
  supplyChainEvents     SupplyChainEvent[]      @relation("EventActor")

  @@map("users")
}

model ProducerProfile {
  id                    String                 @id @default(cuid())
  userId                String                 @unique
  farmName              String
  address               String
  village               String
  tehsil                String
  district              String
  state                 String
  pincode               String
  latitude              Float?
  longitude             Float?
  landSize              Float
  landSizeUnit          String                 @default("acres")
  verificationStatus    VerificationStatus     @default(PENDING)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  batches               Batch[]
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifications         ProducerVerification[]
  verificationDocuments VerificationDocument[]

  @@map("producer_profiles")
}

model Herb {
  id            String   @id @default(cuid())
  commonName    String
  botanicalName String   @unique
  localName     String?
  family        String
  description   String?
  medicinalUse  String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  batches       Batch[]

  @@map("herbs")
}

model Batch {
  id                     String                  @id @default(cuid())
  batchNumber            String                  @unique
  herbId                 String
  producerProfileId      String
  farmLocation           String
  latitude               Float?
  longitude              Float?
  quantity               Float
  unit                   String                  @default("kg")
  harvestDate            DateTime
  cultivationMethod      String
  harvestDetails         String?
  status                 BatchStatus             @default(DRAFT)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  inspections            BatchInspection[]
  herb                   Herb                    @relation(fields: [herbId], references: [id])
  producerProfile        ProducerProfile         @relation(fields: [producerProfileId], references: [id])
  distributorAssignments DistributorAssignment[]
  qrCode                 QRCode?
  qualityTests           QualityTest[]
  supplyChainEvents      SupplyChainEvent[]

  @@index([producerProfileId])
  @@index([herbId])
  @@index([status])
  @@index([batchNumber])
  @@map("batches")
}

model QualityTest {
  id                 String         @id @default(cuid())
  batchId            String
  labId              String
  sampleId           String?        @unique
  assignedBy         String?
  assignedAt         DateTime?
  status             LabTestStatus  @default(PENDING_ASSIGNMENT)
  overallResult      QualityResult?
  receivedAt         DateTime?
  testingStartedAt   DateTime?
  testingCompletedAt DateTime?
  remarks            String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  reports            LabReport[]
  batch              Batch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  lab                User           @relation("TestConductor", fields: [labId], references: [id])
  results            TestResult[]

  @@index([batchId])
  @@index([labId])
  @@map("quality_tests")
}

model TestResult {
  id             String                @id @default(cuid())
  qualityTestId  String
  parameter      String
  value          Float?
  unit           String?
  referenceRange String?
  resultStatus   ParameterResultStatus
  remarks        String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  qualityTest    QualityTest           @relation(fields: [qualityTestId], references: [id], onDelete: Cascade)

  @@index([qualityTestId])
  @@map("test_results")
}

model LabReport {
  id             String      @id @default(cuid())
  qualityTestId  String
  reportNumber   String      @unique
  reportUrl      String
  reportFileName String
  reportFileType String
  status         String      @default("DRAFT")
  generatedBy    String
  generatedAt    DateTime    @default(now())
  finalizedAt    DateTime?
  generator      User        @relation("ReportGenerator", fields: [generatedBy], references: [id])
  qualityTest    QualityTest @relation(fields: [qualityTestId], references: [id], onDelete: Cascade)

  @@index([qualityTestId])
  @@map("lab_reports")
}

model SupplyChainEvent {
  id              String   @id @default(cuid())
  action          String
  location        String?
  notes           String?
  quantity        Float?
  unit            String?
  latitude        Float?
  longitude       Float?
  referenceNumber String?
  timestamp       DateTime @default(now())
  batchId         String
  actorId         String
  actor           User     @relation("EventActor", fields: [actorId], references: [id])
  batch           Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@map("supply_chain_events")
}

model VerificationDocument {
  id                String          @id @default(cuid())
  producerProfileId String
  type              String
  fileUrl           String
  fileName          String
  fileType          String
  uploadedBy        String
  createdAt         DateTime        @default(now())
  producerProfile   ProducerProfile @relation(fields: [producerProfileId], references: [id], onDelete: Cascade)

  @@index([producerProfileId])
  @@map("verification_documents")
}

model ProducerVerification {
  id                  String                @id @default(cuid())
  producerProfileId   String
  authorityId         String?
  assignedBy          String?
  assignedAt          DateTime?
  status              RequestStatus         @default(PENDING)
  decision            VerificationDecision?
  verificationType    String                @default("INITIAL")
  identityVerified    Boolean?
  documentsVerified   Boolean?
  landVerified        Boolean?
  locationVerified    Boolean?
  cultivationVerified Boolean?
  inspectionDate      DateTime?
  latitude            Float?
  longitude           Float?
  observations        String?
  rejectionReason     String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  authority           User?                 @relation("AssignedAuthority", fields: [authorityId], references: [id])
  producerProfile     ProducerProfile       @relation(fields: [producerProfileId], references: [id], onDelete: Cascade)

  @@index([producerProfileId])
  @@index([authorityId])
  @@map("producer_verifications")
}

model BatchInspection {
  id                    String                @id @default(cuid())
  batchId               String
  authorityId           String?
  assignedBy            String?
  assignedAt            DateTime?
  status                InspectionStatus      @default(PENDING)
  decision              VerificationDecision?
  declaredQuantity      Float
  inspectedQuantity     Float?
  herbIdentityVerified  Boolean?
  physicalQualityStatus String?
  packagingStatus       String?
  documentsVerified     Boolean?
  inspectionDate        DateTime?
  latitude              Float?
  longitude             Float?
  observations          String?
  rejectionReason       String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  authority             User?                 @relation("BatchInspector", fields: [authorityId], references: [id])
  batch                 Batch                 @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([authorityId])
  @@map("batch_inspections")
}

model BlockchainRecord {
  id            String                 @id @default(cuid())
  entityType    String
  entityId      String
  recordVersion Int
  dataHash      String
  transactionId String?
  blockNumber   String?
  network       String?
  channel       String?
  chaincode     String?
  status        BlockchainRecordStatus @default(PENDING)
  anchoredAt    DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@unique([entityType, entityId, recordVersion])
  @@index([entityType, entityId])
  @@index([status])
  @@map("blockchain_records")
}

model QRCode {
  id        String       @id @default(cuid())
  code      String       @unique
  batchId   String       @unique
  status    QRCodeStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  revokedAt DateTime?
  revokedBy String?
  batch     Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("qr_codes")
}

model DistributorProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  address       String
  city          String
  district      String
  state         String
  pincode       String
  latitude      Float?
  longitude     Float?
  licenseNumber String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("distributor_profiles")
}

model DistributorAssignment {
  id            String           @id @default(cuid())
  batchId       String
  distributorId String
  assignedBy    String
  assignedAt    DateTime         @default(now())
  status        AssignmentStatus @default(ASSIGNED)
  acceptedAt    DateTime?
  completedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  batch         Batch            @relation(fields: [batchId], references: [id], onDelete: Cascade)
  distributor   User             @relation("AssignedDistributor", fields: [distributorId], references: [id])

  @@index([batchId])
  @@index([distributorId])
  @@index([status])
  @@map("distributor_assignments")
}

model Notification {
  id         String               @id @default(cuid())
  userId     String
  type       NotificationType
  title      String
  message    String
  entityType String?
  entityId   String?
  eventKey   String?
  priority   NotificationPriority @default(NORMAL)
  isRead     Boolean              @default(false)
  readAt     DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventKey])
  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

model AuditLog {
  id            String      @id @default(cuid())
  actorId       String?
  action        AuditAction
  entityType    String?
  entityId      String?
  previousState Json?
  newState      Json?
  metadata      Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime    @default(now())
  actor         User?       @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum Role {
  ADMIN
  PRODUCER
  LAB
  DISTRIBUTOR
  VERIFICATION_AUTHORITY
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum BatchStatus {
  DRAFT
  SUBMITTED
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  READY_FOR_LAB
  QUALITY_APPROVED
  QUALITY_REJECTED
  IN_TRANSIT
  DELIVERED
}

enum RequestStatus {
  PENDING
  ASSIGNED
  UNDER_REVIEW
  COMPLETED
}

enum InspectionStatus {
  PENDING
  UNDER_INSPECTION
  APPROVED
  REJECTED
}

enum VerificationDecision {
  APPROVED
  REJECTED
}

enum LabTestStatus {
  PENDING_ASSIGNMENT
  ASSIGNED
  SAMPLE_RECEIVED
  UNDER_TESTING
  COMPLETED
}

enum QualityResult {
  PASS
  FAIL
}

enum ParameterResultStatus {
  PASS
  FAIL
  NOT_APPLICABLE
}

enum NotificationType {
  PRODUCER_VERIFICATION_SUBMITTED
  PRODUCER_VERIFICATION_APPROVED
  PRODUCER_VERIFICATION_REJECTED
  LOT_INSPECTION_REQUESTED
  LOT_INSPECTION_APPROVED
  LOT_INSPECTION_REJECTED
  LAB_TEST_ASSIGNED
  LAB_SAMPLE_RECEIVED
  LAB_TEST_STARTED
  LAB_TEST_COMPLETED
  LAB_TEST_PASSED
  LAB_TEST_FAILED
  DISTRIBUTOR_ASSIGNED
  BATCH_RECEIVED
  BATCH_DISPATCHED
  BATCH_DELIVERED
  BLOCKCHAIN_ANCHOR_CONFIRMED
  BLOCKCHAIN_ANCHOR_FAILED
  BATCH_STATUS_CHANGED
  QR_GENERATED
  QR_REVOKED
  SYSTEM_ALERT
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum BlockchainRecordStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  FAILED
}

enum QRCodeStatus {
  ACTIVE
  REVOKED
}

enum AssignmentStatus {
  ASSIGNED
  ACCEPTED
  COMPLETED
  CANCELLED
}

enum AuditAction {
  USER_REGISTERED
  USER_LOGIN
  USER_LOGIN_FAILED
  PRODUCER_PROFILE_CREATED
  PRODUCER_PROFILE_UPDATED
  VERIFICATION_REQUESTED
  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
  INSPECTION_REQUESTED
  INSPECTION_STARTED
  INSPECTION_APPROVED
  INSPECTION_REJECTED
  LAB_TEST_ASSIGNED
  LAB_SAMPLE_RECEIVED
  LAB_TEST_STARTED
  LAB_RESULT_ADDED
  LAB_TEST_COMPLETED
  LAB_REPORT_FINALIZED
  DISTRIBUTOR_ASSIGNED
  BATCH_RECEIVED
  BATCH_DISPATCHED
  BATCH_DELIVERED
  BLOCKCHAIN_ANCHORED
  BLOCKCHAIN_ANCHOR_FAILED
  QR_GENERATED
  QR_REVOKED
  SYSTEM_ALERT
}
