# Environment Variables Configuration Template for Dravya AI Engine
# Copy this file to .env for local overrides (never commit .env)

# Configuration File Override
DRAVYA_CONFIG_PATH=configs/config.yaml

# Dataset Root Path Override
DRAVYA_DATASET_ROOT=datasets/raw

# Reports Directory Path Overrides
DRAVYA_REPORTS_DIR=reports/dataset_analysis
DRAVYA_EVALUATION_REPORTS_DIR=reports/model_evaluation

# API Server Configuration
HOST=127.0.0.1
PORT=8000
